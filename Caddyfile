# 源站由 Caddy 自动申请 Let's Encrypt 证书（HTTP-01 经 CF 代理透传）。
# Cloudflare SSL 模式可用 Full / Full (strict)，端到端加密。
{$DOMAIN:medops.leixue.dev} {
	encode zstd gzip
	# Other security headers come from the app (next.config.ts).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy app:3000
}
