# 源站由 Caddy 自动申请 Let's Encrypt 证书（HTTP-01 经 CF 代理透传）。
# Cloudflare SSL 模式可用 Full / Full (strict)，端到端加密。
{
	servers {
		# Only Cloudflare may tell us who the client is. Anyone reaching the
		# origin directly gets their real socket address, whatever headers
		# they send. Ranges: https://www.cloudflare.com/ips/ (fetched 2026-10-10).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN:medops.leixue.dev} {
	encode zstd gzip
	# Other security headers come from the app (next.config.ts).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy app:3000 {
		# The app keys rate limits and audit rows on X-Real-IP; set it here
		# and drop the raw Cloudflare header so clients can't supply either.
		header_up X-Real-IP {client_ip}
		header_up -CF-Connecting-IP
	}
}
